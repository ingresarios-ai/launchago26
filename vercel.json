{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/v2", "destination": "/v2.html" },
    { "source": "/test", "destination": "/test.html" },
    { "source": "/resultado", "destination": "/test.html" },
    { "source": "/app", "destination": "/app.html" },
    { "source": "/identificate", "destination": "/identificate.html" },
    { "source": "/whatsapp", "destination": "/whatsapp.html" },
    { "source": "/wa", "destination": "/whatsapp.html" },
    { "source": "/encuesta", "destination": "/encuesta.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/preactividad1", "destination": "/preactividad1.html" },
    { "source": "/preactividad2", "destination": "/preactividad2.html" },
    { "source": "/guia", "destination": "/guia.html" },
    { "source": "/guia-gracias", "destination": "/guia-gracias.html" },
    { "source": "/guia-antiestafas", "destination": "/guia-antiestafas.html" },
    { "source": "/guia-antiestafas-gracias", "destination": "/guia-antiestafas-gracias.html" },
    { "source": "/cuanto-tienes", "destination": "/cuanto-tienes.html" },
    { "source": "/club-cerrado", "destination": "/club-cerrado.html" },
    { "source": "/falta-metodo", "destination": "/falta-metodo.html" }
  ],
  "headers": [
    {
      "source": "/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
